# ─── Firebase Authentication ───────────────────────────────
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase Console → Project settings → General → "Your apps" → SDK setup & config
# Vite only exposes variables prefixed with VITE_.
# `.env` is gitignored — never commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Admin portal (/admin/login) ───────────────────────────
# Credential login for the admin dashboard. For real security also create this
# user under Firebase Auth → Email/Password (the password is then verified
# server-side and never shipped in the client bundle).
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=
# Optional: comma-separated emails allowed admin access (for Google sign-in too)
VITE_ADMIN_EMAILS=

# ─── Invoice email (EmailJS) ───────────────────────────────
# Sends the invoice from the browser — no backend/SMTP needed.
# Create a free account at https://www.emailjs.com, add an email service +
# template, then copy the IDs here. See docs/EMAIL.md.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
