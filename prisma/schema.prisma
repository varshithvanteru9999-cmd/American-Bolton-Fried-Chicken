// ============================================================
// Favourite Chicken M's — Production Database Schema
// Database: PostgreSQL (recommended via Vercel Postgres / Neon)
// ORM: Prisma
// Phase 2 backend integration target
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum AddonSelectionType {
  SINGLE    // radio — choose one
  MULTIPLE  // checkbox — choose many
}

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TableBookingStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  phone            String?
  firstName        String
  lastName         String
  passwordHash     String?
  role             UserRole  @default(CUSTOMER)
  loyaltyPoints    Int       @default(0)
  isEmailVerified  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses            Address[]
  orders               Order[]
  tableBookings        TableBooking[]
  reviews              Review[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?  // "Home", "Work", etc.
  line1      String
  line2      String?
  city       String
  postcode   String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders  Order[]

  @@index([userId])
}

// ============================================================
// MENU
// ============================================================

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  displayOrder Int
  isActive     Boolean    @default(true)
  imageUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  menuItems  MenuItem[]
}

model MenuItem {
  id           String    @id @default(cuid())
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  name         String
  slug         String    @unique
  description  String?
  basePrice    Decimal   @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  displayOrder Int
  calories     Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addonGroups  AddonGroup[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
}

model AddonGroup {
  id             String             @id @default(cuid())
  menuItemId     String
  menuItem       MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name           String             // "Extras", "Choose your sauce"
  selectionType  AddonSelectionType @default(MULTIPLE)
  isRequired     Boolean            @default(false)
  minSelections  Int                @default(0)
  maxSelections  Int?
  displayOrder   Int                @default(0)

  options  AddonOption[]

  @@index([menuItemId])
}

model AddonOption {
  id            String      @id @default(cuid())
  groupId       String
  group         AddonGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  priceModifier Decimal     @default(0.00) @db.Decimal(10, 2)
  isDefault     Boolean     @default(false)
  isAvailable   Boolean     @default(true)
  displayOrder  Int         @default(0)

  orderItemAddons  OrderItemAddon[]

  @@index([groupId])
}

// ============================================================
// PROMO CODES
// ============================================================

model PromoCode {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            PromoType
  value           Decimal    @db.Decimal(10, 2)  // % or £ depending on type
  minOrderValue   Decimal    @default(0.00) @db.Decimal(10, 2)
  maxDiscount     Decimal?   @db.Decimal(10, 2)  // cap for percentage discounts
  usageLimit      Int?                            // null = unlimited
  usedCount       Int        @default(0)
  isActive        Boolean    @default(true)
  validFrom       DateTime
  validUntil      DateTime?
  createdAt       DateTime   @default(now())

  orders  Order[]

  @@index([code])
  @@index([isActive])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique  // e.g. FCM-1748521
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  type                OrderType
  status              OrderStatus @default(PENDING)

  // Financials — all snapshots at time of order
  subtotal            Decimal     @db.Decimal(10, 2)
  deliveryCharge      Decimal     @default(0.00) @db.Decimal(10, 2)
  serviceCharge       Decimal     @default(0.00) @db.Decimal(10, 2)
  discountAmount      Decimal     @default(0.00) @db.Decimal(10, 2)
  total               Decimal     @db.Decimal(10, 2)

  // Delivery
  deliveryAddressId   String?
  deliveryAddress     Address?    @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  // Promo
  promoCodeId         String?
  promoCode           PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  // Scheduling
  specialInstructions String?
  scheduledAt         DateTime?   // null = ASAP
  estimatedReadyAt    DateTime?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  orderItems  OrderItem[]
  reviews     Review[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  // Snapshots — never rely on live menuItem for historical order data
  itemName     String
  unitPrice    Decimal   @db.Decimal(10, 2)
  quantity     Int       @default(1)
  subtotal     Decimal   @db.Decimal(10, 2)

  addons  OrderItemAddon[]

  @@index([orderId])
}

model OrderItemAddon {
  id            String       @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonOptionId String?
  addonOption   AddonOption? @relation(fields: [addonOptionId], references: [id], onDelete: SetNull)

  // Snapshots
  addonName   String
  price       Decimal  @default(0.00) @db.Decimal(10, 2)

  @@index([orderItemId])
}

// ============================================================
// TABLE BOOKINGS
// ============================================================

model TableBooking {
  id              String             @id @default(cuid())
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  email           String
  phone           String
  bookingDate     DateTime           @db.Date
  bookingTime     DateTime           @db.Time
  partySize       Int
  specialRequests String?
  status          TableBookingStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([bookingDate])
  @@index([status])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  foodRating     Int?     // 1–5
  deliveryRating Int?     // 1–5
  overallRating  Int      // 1–5
  comment        String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([overallRating])
  @@index([isPublished])
}

// ============================================================
// LOYALTY POINTS LEDGER
// ============================================================

model LoyaltyTransaction {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?                // null for manual adjustments/expiry
  type         LoyaltyTransactionType
  points       Int                    // positive = earn, negative = redeem/expire
  balanceAfter Int
  description  String?
  createdAt    DateTime               @default(now())

  @@index([userId])
  @@index([createdAt])
}
